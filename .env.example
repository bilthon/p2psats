# Copy this file to .env (or .env.local) and fill in the values.
# Only VITE_* prefixed vars are exposed to the browser bundle.

# Backend REST API base URL consumed by apiClient.ts.
# Point this at the p2psats-backend service. Omit trailing slash.
# In production this will be something like https://api.p2psats.com
VITE_API_URL=http://localhost:3000

# Contact channels displayed on /contact. Leave blank to render
# "not configured" in italics instead of a link.
VITE_CONTACT_NPUB=
VITE_CONTACT_EMAIL=

# Public site URL — used for canonical URLs and og:image meta tags in the
# prerendered HTML. Falls back to https://p2psats.com if unset. Override in
# preview / staging environments so OG cards point at the right host.
VITE_SITE_URL=https://p2psats.com
